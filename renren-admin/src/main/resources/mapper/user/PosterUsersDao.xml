<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="io.renren.modules.user.dao.PosterUsersDao">

    <resultMap type="io.renren.modules.user.entity.PosterUsersEntity" id="posterUsersMap">
        <result property="id" column="id"/>
        <result property="identity" column="identity"/>
        <result property="mobilePhoneNumber" column="mobile_phone_number"/>
        <result property="nickname" column="nickname"/>
        <result property="password" column="password"/>
        <result property="isAdmin" column="is_admin"/>
        <result property="isOnline" column="is_online"/>
        <result property="schoolId" column="school_id"/>
    </resultMap>

    <!-- 查询用户列表 -->
    <select id="getList" resultType="io.renren.modules.user.entity.PosterUsersEntity">
        SELECT t1.*
        FROM poster_users t1
        WHERE 1=1
        <if test="identity != null and identity.trim() != ''">
            and t1.identity = #{identity}
        </if>
        <if test="nickname != null and nickname.trim() != ''">
            and t1.nickname like #{nickname}
        </if>
    </select>

</mapper>